#!/bin/sh
# Firewall flow offloading: OFF by default (2026-11-25 decision).
#
# History, so nobody re-flips this blindly:
#  - v1.3/v1.4 shipped flow_offloading=1 + flow_offloading_hw=1 (wired IPv4
#    measured >=395 Mbit/s through the PPE, CPU at 7%).
#  - 2026-10-27: with hw=1 the PPE broke IPv6 TCP completely (zx_update_traps
#    cleared the IPv6 ethertype trap); v1.4 patched the driver to keep the
#    trap on while the PPE was active.
#  - 2026-11-25: a boot-time fw4 flowtable generation (whatever its config
#    source) starts the PPE, and the zx_ppe_start/zx_ppe_stop cycle leaves
#    the RX pipeline poisoned - ARP/broadcast dead, "login to LuCI and the
#    network dies".  The driver now hard-refuses every PPE start
#    (zx_ppe_start returns -EOPNOTSUPP), so even a flowtable stays
#    software-only.  A pure-AP fleet gains nothing from flow offload anyway,
#    so the default is now fully off; the boot-time 20-firewall hotplug can
#    generate all the software flowtables it likes, they are inert.
#
# To re-enable (software only; the PPE path cannot start by driver policy):
#   uci set firewall.@defaults[0].flow_offloading='1'
#   uci commit firewall && fw4 restart
uci -q batch <<-EOF
	set firewall.@defaults[0].flow_offloading='0'
	set firewall.@defaults[0].flow_offloading_hw='0'
	commit firewall
EOF
exit 0
