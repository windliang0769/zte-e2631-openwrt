#!/bin/sh
# v24: give br-lan a STABLE MAC derived from the board's own WiFi EEPROM.
#
# On the RAX1800-Z the ZX279128R ethernet ports have no factory MAC that the
# mainline driver can read, so the kernel assigns a random locally-administered
# MAC to each lanX port on every boot. Linux then picks one of them as br-lan's
# MAC. Windows NLA fingerprints a wired network mainly by the MAC of its
# default gateway, so every router reboot looked like a brand-new network
# ("Network 2", "Network 3", ... "Network 34" on the user's PC) and Windows
# asked again whether to allow device discovery on it.
#
# The vendor assigns consecutive MACs: LAN = 2.4G - 1, 2.4G = eeprom value,
# 5G = 2.4G + 1. On the lab unit those are
#   a8:61:df:a1:a9:e9 (LAN) / :ea (2.4G) / :eb (5G),
# and :e9 is also written in the vendor's "wlan" partition. The 2.4G MAC lives
# at offset 4 of the baked MT7915 eeprom (same bytes the driver uses for
# phy0-ap0), so deriving LAN from it gives every board its own unique, stable,
# globally-unique value with no per-unit hardcoding.
#
# Idempotent: never overwrite an explicitly configured macaddr.

ee=/lib/firmware/mediatek/mt7915_eeprom.bin
[ -f "$ee" ] || exit 0
[ "$(uci -q get network.@device[0].name)" = "br-lan" ] || exit 0
[ -z "$(uci -q get network.@device[0].macaddr)" ] || exit 0

hex=$(hexdump -v -s 4 -n 6 -e '6/1 "%02x"' "$ee" 2>/dev/null)
[ ${#hex} -eq 12 ] || exit 0

last_hex=$(echo "$hex" | cut -c11-12)
last=$((0x$last_hex - 1))
[ "$last" -ge 0 ] || exit 0

full=$(echo "$hex" | sed 's/\(..\)\(..\)\(..\)\(..\)\(..\)\(..\)/\1:\2:\3:\4:\5:\6/')
mac="${full%:*}:$(printf '%02x' "$last")"

uci set network.@device[0].macaddr="$mac"
uci commit network

exit 0
