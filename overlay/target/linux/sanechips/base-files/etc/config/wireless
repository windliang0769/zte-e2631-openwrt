# Shipped so that uci wireless has a @wifi-device from the very first boot.
#
# LuCI hides "Network -> Wireless" unless this file has a wifi-device section
# ("depends": {"uci": {"wireless": {"@wifi-device": true}}} in
# /usr/share/luci/menu.d/luci-mod-network.json), and /usr/share/ucode/luci/
# dispatcher.uc CACHES that verdict in /tmp/luci-indexcache.<hash>.json,
# keyed only on the menu.d file list -- so whichever answer it computed on the
# first page load after boot sticks until the next reboot.
#
# 2026-11-11: the radio defaults are SHIPPED ENABLED with WPA2-PSK:
#   2.4G  RAX1800Z      HE20 (Wi-Fi 6 / AX), channel auto
#   5G    RAX1800Z-5G   HE80 (Wi-Fi 6 / AX), channel auto
#   key   ********      (8 chars, exactly as requested)
# e2631-wifi-boot's factory_wireless() sees disabled=0, treats the file as
# user-configured and NEVER rewrites SSID/key/state - the bring-up flow only
# loads the driver and runs "wifi up".  Change anything freely in LuCI.
#
# The driver still comes up late (e2631-wifi-load S95 -> e2631-wifi-boot
# DEFER=25 -> bind -> "wifi up"), so the SSIDs appear ~30-60 s after power
# on.  That deferral is deliberate: the firmware-DMA window must stay out of
# the boot-critical path (see known-issues WIFI-COLD-BIND-HANG).
#
# The paths are this board's shape: ONE pci function hosting two phys
# (phy0 = 2.4G, phy1 = 5G); "+1" selects the second phy on the same device.

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'soc/f000000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option band '2g'
	option channel 'auto'
	option htmode 'HE20'
	option country 'CN'
	option disabled '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'soc/f000000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0+1'
	option band '5g'
	option channel 'auto'
	option htmode 'HE80'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'RAX1800Z'
	option encryption 'psk2'
	option key '********'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'RAX1800Z-5G'
	option encryption 'psk2'
	option key '********'
	option disabled '0'
