#!/bin/sh
# v25: give every RAX1800Z its OWN factory MAC, read from its own flash.
#
# The image ships a baked MT7915 eeprom blob (the vendor "wlan" JFFS2 cannot
# be mounted under mainline Denali ECC), and that blob carries the MACs of the
# machine it was extracted from.  Flashing the image into a second router
# would otherwise give both boxes the same LAN MAC and WiFi BSSIDs.
#
# This unit's identity lives in its own "wlan" partition raw bytes, in TWO
# shapes depending on the unit (both observed in the fleet so far):
#
# 1. binary - the unit's MT7915_EEPROM.bin data node:  the blob starts
#      15 79 00 00 <2.4G MAC:6> <5G MAC:6>
#    with 5G = 2.4G + 1.  JFFS2 does not compress, so the bytes survive a raw
#    partition read even where mounting fails wholesale.
#      unit A: a8:61:df:a1:a9:ea / a8:61:df:a1:a9:eb
#      unit B: ac:56:7b:ea:26:03 / ac:56:7b:ea:26:04
# 2. text - the MAP ALID in 1905d.cfg (map_controller_alid = the LAN MAC,
#    e.g. a8:61:df:a1:a9:e9 on unit A).  NOTE: some units ship a PLACEHOLDER
#    here (00:0c:43:88:88:88 on unit B), so text is only a fallback, never
#    authoritative.
#
# Family (exactly the vendor's assignment, also what the baked eeprom holds):
#   LAN  = 2.4G - 1    5G = 2.4G + 1
#
# Called from /etc/init.d/e2631-wifi-eeprom (S05), i.e. BEFORE the wifi
# driver is bound at S95, so patching the eeprom blobs takes effect.
# Idempotent and safe on every boot; never overwrites a user-set macaddr.

CACHE=/etc/board-mac
FWDIR=/lib/firmware/mediatek
log() { echo "board-mac: $*" > /dev/kmsg; }

# --- locate the "wlan" mtd character device ---
dev=""
for d in /sys/class/mtd/mtd[0-9]*; do
	[ "$(cat "$d/name" 2>/dev/null)" = "wlan" ] || continue
	dev=/dev/${d##*/}
	break
done

# --- source 1 (authoritative): binary EEPROM signature scan ---
# 15790000 + 24 hex chars (2.4G MAC then 5G MAC, 5-byte prefix equal,
# last byte +1, unicast/nonzero first byte).  Most frequent hit wins.
mac=""
w2=""
if [ -n "$dev" ]; then
	w2=$(od -An -v -tx1 "$dev" 2>/dev/null | tr -d ' \n' | awk '
		BEGIN {
			for (j = 0; j < 256; j++)
				if (j % 2 == 0 && j != 0 && j != 2 && j != 254)
					ok[sprintf("%02x", j)] = 1
			for (j = 0; j < 255; j++)
				inc[sprintf("%02x%02x", j, j + 1)] = 1
		}
		{ s = s $0 }
		END {
			p = "15790000"; n = length(s)
			pos = 1
			while (1) {
				k = index(substr(s, pos), p)
				if (!k) break
				k += pos - 1; pos = k + length(p)
				if (k + length(p) + 24 > n + 1) break
				m1 = substr(s, k + length(p), 12)
				m2 = substr(s, k + length(p) + 12, 12)
				key = substr(m1, 11, 2) substr(m2, 11, 2)
				if (substr(m1, 1, 10) == substr(m2, 1, 10) &&
				    (substr(m1, 1, 2) in ok) && (key in inc))
					cnt[m1]++
			}
			best = ""; bc = 0
			for (m in cnt) if (cnt[m] > bc) { bc = cnt[m]; best = m }
			print best
		}')
	if [ -n "$w2" ]; then
		h=$(echo "$w2" | tr -d ':')
		num=$((0x$h))
		mac=$(printf '%012x' $((num - 1)))
		src=eeprom
	fi
fi

# --- source 2 (fallback): text ALID scan, sample addresses excluded ---
if [ -z "$mac" ] && [ -n "$dev" ]; then
	mac=$(strings "$dev" 2>/dev/null |
	      grep -oE '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' |
	      grep -viE '^(00:0c:43|00:41:71|00:00:00|ff:ff:ff|02:0c:43|06:0c:43|33:33:|01:00:5e)' |
	      tr 'A-F' 'a-f' | sort | uniq -c | sort -rn | head -1 | awk '{print $2}')
	[ -n "$mac" ] && src=alid
fi

# --- fallbacks: cached value, then a stable locally-administered MAC ---
if [ -z "$mac" ] && [ -f "$CACHE" ]; then
	mac=$(cat "$CACHE")
	src=cache
fi
if [ -z "$mac" ]; then
	u=$(cat /proc/sys/kernel/random/uuid | tr -d '-')
	mac="02:$(echo "$u" | cut -c1-2):$(echo "$u" | cut -c3-4):$(echo "$u" | cut -c5-6):$(echo "$u" | cut -c7-8):$(echo "$u" | cut -c9-10)"
	src=generated
	log "WARNING: no factory MAC readable from $dev; generated $mac"
fi
[ "$mac" = "$(cat "$CACHE" 2>/dev/null)" ] || echo "$mac" > "$CACHE"

# --- derive the WiFi MACs as 12-hex-digit strings ---
h=$(echo "$mac" | tr -d ':')
num=$((0x$h))
w2=$(printf '%012x' $((num + 1)))
w5=$(printf '%012x' $((num + 2)))

tobytes() { echo "$1" | sed 's/../& /g'; }

# --- patch the baked eeprom blobs in place (only the 12 MAC bytes) ---
for ee in "$FWDIR/mt7915_eeprom.bin" "$FWDIR/mt7915_eeprom_dbdc.bin"; do
	[ -f "$ee" ] || continue
	tmp=/tmp/board-mac.$$
	cp -f "$ee" "$tmp" || continue
	off=4
	for b in $(tobytes "$w2") $(tobytes "$w5"); do
		oct=$(printf '%03o' "0x$b")
		printf "\\$oct" | dd of="$tmp" bs=1 seek=$off conv=notrunc 2>/dev/null
		off=$((off + 1))
	done
	if ! cmp -s "$tmp" "$ee"; then
		cp -f "$tmp" "$ee"
		log "patched ${ee##*/}: 2.4G=$w2 5G=$w5"
	fi
	rm -f "$tmp"
done

# --- br-lan identity (Windows NLA fingerprints the gateway MAC) ---
# The flash value is authoritative: a stale config snapshot restored at
# preinit could otherwise carry another unit's MAC into this box.
if [ "$(uci -q get network.@device[0].name)" = "br-lan" ]; then
	cur=$(uci -q get network.@device[0].macaddr)
	if [ "$cur" != "$mac" ]; then
		uci set network.@device[0].macaddr="$mac"
		uci commit network
		log "br-lan macaddr=$mac (was ${cur:-unset})"
	fi
fi

log "ready: lan=$mac 2.4G=$w2 5G=$w5 (source=$src)"
exit 0
