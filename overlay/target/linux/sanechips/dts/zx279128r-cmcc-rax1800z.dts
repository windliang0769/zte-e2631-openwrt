// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
/*
 * CMCC RAX1800-Z (CMIT:2021AP99, 2021-10-10) on the Sanechips ZX279128R SoC.
 *
 * Everything below was read off the real hardware:
 *  - register addresses / interrupt numbers / clock references come from the
 *    STOCK vendor device tree, exported live over TTL from
 *    /sys/firmware/devicetree/base (269 properties, see
 *    _dl/nand_backup/analysis/devicetree.md in the working repo)
 *  - the NAND node compatible "denali,denali-nand-dt" is the stock mainline
 *    Denali DT binding, so no driver port is needed - only
 *    CONFIG_MTD_NAND_DENALI(_DT) in the kernel config
 *  - flash geometry measured from the dump: 128 MiB parallel SLC NAND,
 *    2 KiB pages, 64 B OOB, 128 KiB erase blocks, ZERO bad blocks
 *
 * Differences vs the ZXHN H3600 / E2631 boards this base tree targets:
 *  - 512 MiB DRAM (they have 256 MiB)
 *  - PARALLEL Denali NAND instead of SPI-NAND via spifc
 *  - 12 partitions, A/B slots at kernel0@0x200000/kernel1@0x700000
 *  - external switch/PHY stack (sw@92300000 + gephy128s@9b000000) instead of
 *    the SoC-internal 4 GbE PHYs - ethernet bring-up is the big unknown
 *  - MT7915 (not MT7916) on PCIe; wlan/caldata partition starts all 0xFF
 *
 * Slot policy: OpenWrt owns slot A (kernel0 + rootfs0); slot B
 * (kernel1 + rootfs1) stays STOCK and is the rollback path.  The U-Boot env
 * decides which one boots, so B is never touched by any OpenWrt write.
 */

/dts-v1/;

#include "zte/zx279128s.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "CMCC RAX1800-Z";
	compatible = "cmcc,rax1800-z", "zte,zx279128r", "zte,zx279128s";

	aliases {
		serial0 = &serial0;
		ethernet0 = &gmac;
	};

	/*
	 * The stock U-Boot passes its own bootargs (root=/dev/mtdblock6, the
	 * vendor slot B rootfs).  CONFIG_CMDLINE_FORCE overrides them; the
	 * chosen/bootargs line below is the belt to that suspenders.  ROOTDEV
	 * counts partition ROWS in the fixed-partitions table below:
	 * u-boot=0, u-boot-env=1, kernel=2, rootfs=3 -> /dev/mtdblock3.
	 */
	chosen {
		bootargs = "console=ttyAMA0,115200n8 root=/dev/mtdblock3 rootfstype=squashfs ro rootwait";
	};

	/* stock DT: /memory@40000000 reg = <0x40000000 0x20000000> */
	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x20000000>;
	};

	/*
	 * Linux 6.18 denali_dt_probe() calls devm_clk_get_enabled() for THREE
	 * NAMED clocks ("nand", "nand_x", "ecc") and derives the NAND timing
	 * from their rates.  The stock DT only has one &topcrm 0x31 clock whose
	 * ID space the mainline clock driver does not implement, and a missing
	 * clock makes probe fail outright (not defer).  Three fixed-clocks keep
	 * probe deterministic.
	 *
	 * Rates matter: denali_setup_data_interface() (drivers/mtd/nand/raw/
	 * denali.c, ~line 791) rejects the probe with -EINVAL unless
	 *   mult_x = clk_x_rate / clk_rate   is in [4, 6]
	 * BEFORE it even issues READID.  An earlier 200/100 MHz pair gave
	 * mult_x = 0.5 and produced "Failed to configure data interface" +
	 * "No NAND device found".  50 MHz core / 200 MHz bus gives mult_x = 4.
	 *
	 * Verified on hardware (v8.1 RAM boot): S34ML01G2 128 MiB SLC detected,
	 * 12 MTD partitions created, mtd0 read back byte-for-byte identical to
	 * _dl/nand_backup/nand_full_128MiB.bin, and a 64-page dd read with no
	 * ECC errors.  These are the exact values from that boot, not guesses.
	 */
	nand_clk: nand-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
	};

	nand_x_clk: nand-x-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;
	};

	nand_ecc_clk: nand-ecc-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;
	};
};

/* The console UART - without this the kernel goes silent at "Starting kernel". */
&serial0 {
	status = "okay";
};

&serial1 {
	status = "okay";
};

/*
 * Parallel NAND via the mainline Denali DT driver.
 * Register addresses / IRQ / reg-names come from the stock vendor DT.
 *
 * Linux 6.18 changes that matter here (measured on real hardware, v7):
 *  - of_match_table no longer contains the generic "denali,denali-nand-dt";
 *    patch 035 restores it with a ZTE .data entry.  Without it the device
 *    never binds, and a forced bind hits WARN_ON(!data) -> -EINVAL.
 *  - probe requires the three named clocks above; they are NOT optional.
 *  - denali_dt_chip_init() walks every DIRECT child as a NAND chip and reads
 *    its "reg" as the bank list, so fixed-partitions must live one level
 *    deeper, inside a chip node.  A bare partitions child fails with -EINVAL.
 */
&{/soc} {
	nand@00d80000 {
		compatible = "denali,denali-nand-dt";
		reg = <0x00d80000 0x07c00000>, <0x00d00000 0x00080000>;
		reg-names = "nand_data", "denali_reg";
		interrupts = <0 20 4>;
		clocks = <&nand_clk>, <&nand_x_clk>, <&nand_ecc_clk>;
		clock-names = "nand", "nand_x", "ecc";
		dma-mask = <0xffffffff>;
		status = "okay";

		#address-cells = <1>;
		#size-cells = <1>;

		nand@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* 0x00000000-0x00180000: U-Boot code. NEVER write this. */
			u_boot: partition@0 {
				label = "u-boot";
				reg = <0x00000000 0x00180000>;
				read-only;
			};

			/* 0x00180000-0x001a0000: live U-Boot env (128 KiB, CRC-checked).
			 * Kept writable so fw_setenv can switch the boot slot. */
			u_boot_env: partition@180000 {
				label = "u-boot-env";
				reg = <0x00180000 0x00020000>;
			};

			/* ---- slot A: OpenWrt ---- */
			partition@200000 {
				label = "kernel";
				reg = <0x00200000 0x00500000>;
			};

			/* squashfs lands here; erase blocks behind it become the
			 * writable rootfs_data overlay (mainline squashfs-split). */
			partition@c00000 {
				label = "rootfs";
				reg = <0x00c00000 0x02000000>;
			};

			/* ---- slot B: untouched stock system (rollback) ---- */
			kernel1_b: partition@700000 {
				label = "kernel1-stock";
				reg = <0x00700000 0x00500000>;
				read-only;
			};

			rootfs1_b: partition@2c00000 {
				label = "rootfs1-stock";
				reg = <0x02c00000 0x02000000>;
				read-only;
			};

			/* ---- vendor data areas ---- */
			partition@4c00000 {
				label = "parameter-tags";
				reg = <0x04c00000 0x00200000>;
			};

			partition@4e00000 {
				label = "usercfg";
				reg = <0x04e00000 0x00500000>;
			};

			/* BootPara lives in the first 72 bytes of this partition */
			partition@5300000 {
				label = "others";
				reg = <0x05300000 0x00100000>;
			};

			partition@5400000 {
				label = "wlan";
				reg = <0x05400000 0x00300000>;
			};

			partition@5700000 {
				label = "middleware";
				reg = <0x05700000 0x00100000>;
			};

			partition@5800000 {
				label = "versionbackup";
				reg = <0x05800000 0x02000000>;
			};

			/* 0x07800000-0x08000000 unpartitioned tail, all 0xFF */
		};
		};  /* nand@0 chip node */
	};
};

/*
 * ETHERNET.  v7 measured "zx279128s-eth 92000000.ethernet: error -ENODEV:
 * no usable port": every gmac_portN ships status="disabled" in the SoC dtsi
 * and the board DTS never enabled one, so the driver had nothing to register.
 * Enable four ports the way the sibling E2631 board does; the fifth stays off.
 *
 * RAX1800-Z uses an external switch block (sw@92300000, "zte,zx279127-sw")
 * plus four gephy128s windows, so these MDIO addresses are a hypothesis.
 * Verify on the next RAM boot with
 *   ls /sys/bus/mdio_bus/devices ; dmesg | grep -i -e gmac -e phy ; ip link
 * A board whose network does not work is still usable over serial + WiFi and
 * this does not block the flash path.
 */
&gmac {
	status = "okay";
};

&gmac_port0 {
	label = "lan3";
	phy-handle = <&phy10>;
	phy-mode = "internal";
	status = "okay";
};

&gmac_port1 {
	label = "lan2";
	phy-handle = <&phy11>;
	phy-mode = "internal";
	status = "okay";
};

&gmac_port2 {
	label = "lan1";
	phy-handle = <&phy12>;
	phy-mode = "internal";
	status = "okay";
};

&gmac_port3 {
	label = "wan";
	phy-handle = <&phy13>;
	phy-mode = "internal";
	status = "okay";
};

&gmac_port4 {
	status = "disabled";
};

&mdio {
	status = "okay";

	phy10: ethernet-phy@a {
		reg = <10>;
	};

	phy11: ethernet-phy@b {
		reg = <11>;
	};

	phy12: ethernet-phy@c {
		reg = <12>;
	};

	phy13: ethernet-phy@d {
		reg = <13>;
	};
};

/* WiFi: MT7915 on PCIe (stock /kmodule/mt7915_ap.ko confirms the chip).
 * The vendor wlan/caldata partition starts with 64 KiB of 0xFF, so mt76 will
 * have to fall back to OTP or a placeholder calibration - bring this up with
 * the serial console attached before trusting it. */
/ {
	soc {
		/*
		 * SoC on-die temperature sensor.  The register window, the
		 * four-step CFG pulse sequence and the non-linear calibration
		 * were recovered from the OEM 4.1.25 kernel (temp_zx.c) and
		 * verified on hardware: /proc/tempsensor reported 37..38 C at
		 * ADC 755..756.  /soc is simple-bus with an empty ranges (1:1),
		 * so this reg maps straight to physical 0x94100034.
		 *
		 * kmod-rax1800z-thermal binds here and registers a hwmon
		 * temp1_input.  The three OEM interrupts are threshold/selector
		 * groups, not separate sensors - this driver polls, so none are
		 * listed.  No clocks: dmesg showed "work clock 0".
		 */
		temp@94100034 {
			compatible = "zxic,tempsensor";
			reg = <0x94100034 0x0000000c>;
			status = "okay";
		};

		/*
		 * Second handle for the 0x94000000 block, same trick as the
		 * E2631 port: the topcrm node is claimed by CLK_OF_DECLARE and
		 * marked OF_POPULATED, so of_platform_bus_create refuses to
		 * descend and none of its children (pcie phys, syscon-reboot)
		 * ever become devices.  A syscon+simple-mfd duplicate lets the
		 * bus walk populate them.  Addresses are identical - both
		 * drivers find their regmap through the parent.
		 */
		crm1: syscon@94000000 {
			compatible = "syscon", "simple-mfd";
			reg = <0x94000000 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;

			crm1_pcie0_phy: phy@0 {
				compatible = "zte,zx279128s-pcie-phy";
				reg = <0>;
				#phy-cells = <0>;
			};

			crm1_pcie1_phy: phy@1 {
				compatible = "zte,zx279128s-pcie-phy";
				reg = <1>;
				#phy-cells = <0>;
			};
		};
	};
};

&pcie0 {
	phys = <&crm1_pcie0_phy>;
	phy-names = "pcie";
	status = "okay";
};

&pcie1 {
	phys = <&crm1_pcie1_phy>;
	phy-names = "pcie";
	status = "okay";
};

/* Stock kernel ships "# CONFIG_USB is not set"; keep USB off for the same
 * hang-safety reason the E2631 port did. */
&usb {
	status = "disabled";
};

/* Serialize PL310 maintenance with protected MMIO, same as E2631. */
&l2cc {
	zte,l2c-io-read-lock;
};
