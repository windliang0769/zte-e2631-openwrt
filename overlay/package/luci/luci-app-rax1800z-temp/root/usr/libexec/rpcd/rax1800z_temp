#!/bin/sh
# Read-only temperature aggregator for the RAX1800Z status overview.
#
# rpcd shell-plugin protocol:
#   $1=list             -> print the method table
#   $1=call, $2=temps   -> print the JSON reply
#
# Only exported kernel sysfs files are read. All raw values are millidegree
# Celsius:
#   /sys/class/thermal/thermal_zoneX/temp  -> CPU / SoC thermal zone
#   /sys/class/hwmon/hwmonX/temp1_input    -> zxic_tsensor (kmod-rax1800z-thermal)
#                                            and mt7915 / mt7916 (mainline mt76)
# The hwmon name filter below matches *zxic* for the SoC sensor, so the CPU
# number appears as soon as that kmod is loaded - no frontend change needed.
#
# Every source is optional. A missing sensor is reported as JSON null so the
# page shows "N/A" instead of inventing a number. No NAND writes, no ioctl,
# no vendor register reads: this plugin cannot brick or reboot the board.
#
# BusyBox compatibility: no tr, no arrays, no bash-only expansions.

valid() {
	[ -r "$1" ] || return 1
	v=$(cat "$1" 2>/dev/null) || return 1
	case "$v" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$v" -gt 0 ] 2>/dev/null || return 1
	[ "$v" -lt 150000 ] 2>/dev/null || return 1
	printf '%s' "$v"
}

# "49°C" for a valid Celsius integer, "N/A" for null/empty - the same shape
# the status-overview row renders, exposed as the reference router's
# luci getTempInfo string format.
fmt_deg() {
	case "$1" in
		null|'') printf 'N/A' ;;
		*) printf '%s°C' "$1" ;;
	esac
}

is_cpu_label() {
	case "$1" in
		*cpu*|*CPU*|*soc*|*SoC*|*SOC*|*tsens*|*TSENS*|*zxic*|*ZXIC*|*ddr*|*DDR*)
			return 0 ;;
	esac
	return 1
}

is_wifi_label() {
	case "$1" in
		mt7915*|mt7916*|MT7915*|MT7916*|mt76*|MT76*|mt798*|MT798*)
			return 0 ;;
	esac
	return 1
}

cpu=null
for z in /sys/class/thermal/thermal_zone*/temp; do
	[ -f "$z" ] || continue
	m=$(valid "$z") || continue
	t=$(cat "${z%/temp}/type" 2>/dev/null)
	# WiFi chips register thermal zones too. Only a CPU/SoC-labelled zone
	# may be shown as the CPU temperature.
	is_cpu_label "$t" || continue
	cpu=$((m / 1000))
	break
done

wifi=''
wn=0
for h in /sys/class/hwmon/hwmon*/temp1_input; do
	[ -r "$h" ] || continue
	m=$(valid "$h") || continue
	nm=$(cat "${h%/temp1_input}/name" 2>/dev/null)
	if is_wifi_label "$nm"; then
		wifi="${wifi:+$wifi,}$((m / 1000))"
		wn=$((wn + 1))
	elif [ "$cpu" = null ] && is_cpu_label "$nm"; then
		cpu=$((m / 1000))
	fi
done

# Compose the reference-router string:
#   "CPU: 49°C, WiFi0: 51°C, WiFi1: 48°C"
# The Wi-Fi slot count mirrors the frontend: at least two slots (the board
# enumerates two mt76 chips), extra radios appended as WiFi2..; missing
# sensors render as N/A, never as a made-up number.
tempinfo() {
	s="CPU: $(fmt_deg "$cpu")"
	n=$wn
	[ "$n" -lt 2 ] && n=2
	# Split the "48,49" wifi list on commas without cut: with a single
	# entry there is no delimiter, and `cut -s` would then drop the whole
	# line. Positional params do the job in plain BusyBox sh.
	IFS=,
	set -- $wifi
	unset IFS
	i=0
	while [ "$i" -lt "$n" ]; do
		if [ "$i" -lt "$wn" ]; then
			eval "w=\$$((i + 1))"
			[ -n "$w" ] || w=null
		else
			w=null
		fi
		s="$s, WiFi$i: $(fmt_deg "$w")"
		i=$((i + 1))
	done
	printf '%s' "$s"
}

case "$1" in
list)
	# The only ubus method this plugin registers is "temps" (used by the
	# status-overview include). The reference router's
	# `ubus call luci getTempInfo` is provided by apply.sh's patch of the
	# luci-base ucode plugin, which runs THIS FILE as an executable
	# (`call getTempInfo` below) - that path never crosses ubus, so it is
	# intentionally not listed here.
	printf '{ "temps": {} }\n'
	;;
call)
	case "$2" in
	temps)
		printf '{"cpu":%s,"wifi":[%s],"wifi_count":%d}\n' "$cpu" "$wifi" "$wn"
		;;
	getTempInfo)
		printf '{"tempinfo":"%s"}\n' "$(tempinfo)"
		;;
	*)
		printf '{}\n'
		;;
	esac
	;;
*)
	printf '{}\n'
	;;
esac

exit 0
